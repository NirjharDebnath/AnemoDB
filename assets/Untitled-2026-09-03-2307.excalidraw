    {
      "id": "EmxpcTbm6djnYTVCw4jOG",
      "type": "text",
      "x": 3349.04521845636,
      "y": -232.92216474670852,
      "width": 754.6034545898438,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
