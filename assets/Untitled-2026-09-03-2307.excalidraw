    {
      "id": "7_yPuMra7awntfD0IhPds",
      "type": "text",
      "x": 2821.1907547315004,
      "y": 1105.1803318886496,
      "width": 665.4587402343755,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1b",
      "roundness": null,
      "seed": 924157396,
      "version": 115,
      "versionNonce": 473822956,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788463128116,
      "link": null,
      "locked": false,
      "text": "DETAILS\n\n* CacheNode Struct (Fine-Grained Synchronization Node)\n* Contains payload data (`key`, `value`), lazy TTL timestamp\n(`expiration_time`), and an atomic state machine\n(`IN_PROGRESS`, `READY`, `FAILED`).\n* Holds an isolated `std::mutex` and\n`std::condition_variable` per node to enable request\ncoalescing without holding the global cache lock.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DETAILS\n\n* CacheNode Struct (Fine-Grained Synchronization Node)\n* Contains payload data (`key`, `value`), lazy TTL timestamp (`expiration_time`), and an atomic state machine (`IN_PROGRESS`, `READY`, `FAILED`).\n* Holds an isolated `std::mutex` and `std::condition_variable` per node to enable request coalescing without holding the global cache lock.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
