    {
      "id": "oN8-ZSjYSRYeFtUlMLxld",
      "type": "text",
      "x": 2944.717625765576,
      "y": -39.7212037926775,
      "width": 510.05450837742586,
      "height": 243.33333333333354,
      "angle": 0,
