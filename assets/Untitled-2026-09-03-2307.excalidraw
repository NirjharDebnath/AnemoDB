      "index": "b2M",
      "roundness": null,
      "seed": 1093919340,
      "version": 286,
      "versionNonce": 341118420,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788464498711,
      "link": null,
      "locked": false,
      "text": "FEATURES\n\n* Fixed Server Pool vs. Dynamic Client\nLoad - Server worker count remains fixed\nat boot to match database connection pool\nconstraints.\n* Handles dynamic client-side load scaling\nsmoothly by buffering surplus work in the\ntask queue.",
      "fontSize": 21.629629629629648,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FEATURES\n\n* Fixed Server Pool vs. Dynamic Client Load - Server worker count remains fixed at boot to match database connection pool constraints.\n* Handles dynamic client-side load scaling smoothly by buffering surplus work in the task queue.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
